{
	"name": "gpuix-svelte-sveltekit-shared-components-demo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "node dev.ts",
		"dev:web": "vite dev --open",
		"dev:gpuix": "node node_modules/gpuix-svelte/bin/gpuix-svelte.js app.ts",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:gpuix": "tsc --noEmit -p tsconfig.gpuix.json && svelte-check --tsconfig ./tsconfig.gpuix.json --diagnostic-sources js,svelte --fail-on-warnings",
		"check:all": "npm run check && npm run check:gpuix",
		"start": "node dev.ts",
		"test": "node node_modules/gpuix-svelte/bin/gpuix-svelte.js test.ts"
	},
	"dependencies": {
		"gpuix-svelte": "file:../gpuix-svelte"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	}
}
